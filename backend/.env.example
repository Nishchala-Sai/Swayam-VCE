# Copy to backend/.env and fill in. Never commit .env.

# PRIVATE. Neon dashboard > Connection details > pooled connection string
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# PRIVATE. At least 32 random characters:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long a login lasts (jsonwebtoken format: 7d, 12h, ...)
JWT_EXPIRES_IN=7d

# PRIVATE in production. Cloudflare dashboard > Turnstile > your widget > Secret key.
# For local development use Cloudflare's test secret, which accepts any token:
#   1x0000000000000000000000000000000AA   (always passes)
#   2x0000000000000000000000000000000AA   (always fails, to test the 403)
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# PRIVATE. Signs QR tickets. At least 32 random characters, different from JWT_SECRET:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing it invalidates every ticket already issued.
QR_SECRET=

# Google sign-in (optional). The Firebase project id from Firebase console > Project settings. Not secret.
# Without it, POST /api/auth/google-login answers 503 and everything else works.
FIREBASE_PROJECT_ID=

# Public URL of the website, used to build password-reset links. Defaults to the first CORS_ORIGIN.
FRONTEND_URL=http://localhost:5173

PORT=4000
NODE_ENV=development

# Proxies in front of the API: 0 locally, 1 on Render alone, 2 on Render behind the Vercel /api rewrite. Rate limiting depends on this being right.
TRUST_PROXY=0

# Where uploaded UPI QR and banner images are saved (default backend/uploads). On hosts whose disk is wiped on redeploy
# (Render free tier), point this at a persistent disk.
UPLOAD_DIR=

# Cloudinary for uploaded images (UPI QR codes, event banners). From the Cloudinary console: cloudinary://<key>:<secret>@<cloud_name>.
# When set, uploads go to Cloudinary and UPLOAD_DIR is not used.
CLOUDINARY_URL=

# Emails (password reset, payment confirmed) through Brevo's SMTP relay, smtp-relay.brevo.com:587.
# Brevo > SMTP & API > SMTP: the SMTP login, and an SMTP key (PRIVATE). Either unset: emails are printed in this
# terminal instead.
BREVO_SMTP_USER=
BREVO_SMTP_PASS=
# Sender. Must be a sender or domain verified in Brevo (Brevo > Senders, domains & dedicated IPs).
EMAIL_FROM=Swayam E-Cell <noreply@your-domain>

# Frontend URL(s), comma separated. Cookies are only sent to these origins.
CORS_ORIGIN=http://localhost:5173
