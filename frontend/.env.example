# Copy to frontend/.env.local. Everything here ends up in the browser, so it is all public by design.

# API base URL. Leave empty in development (Vite proxies /api to http://localhost:4000).
# In production: the API's URL, e.g. https://api.swayam.example (no trailing slash).
VITE_API_URL=

# Firebase web app config for "Sign in with Google", the only way to sign in (Firebase console > Project settings >
# Your apps). FIREBASE_PROJECT_ID in backend/.env must be the same project. Without these, sign in locally with a
# link from the backend: npm run login-link -- <email>.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
